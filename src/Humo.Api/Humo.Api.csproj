<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Humo.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same convention as Humo.Core: services are internal and registered
         through DI, and the tests construct them directly. -->
    <InternalsVisibleTo Include="Humo.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Humo.Shared\Humo.Shared.csproj" />
  </ItemGroup>

  <!-- The API references Humo.Shared and nothing from the client. Sharing the
       DTOs with the app is what stops the wire contract drifting. -->

</Project>
