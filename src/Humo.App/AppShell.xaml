<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:loc="clr-namespace:Humo.App.Localization"
       xmlns:views="clr-namespace:Humo.App.Views"
       x:Class="Humo.App.AppShell">

    <!-- The cook screen is the app's home: opening Humo mid-cook must land on
         the thing that is happening, not on a menu. -->
    <TabBar>
        <ShellContent Title="{loc:Translate App_Name}"
                      ContentTemplate="{DataTemplate views:ActiveCookPage}"
                      Route="activecook" />
        <ShellContent Title="{loc:Translate History_Title}"
                      ContentTemplate="{DataTemplate views:CookHistoryPage}"
                      Route="history" />
        <ShellContent Title="{loc:Translate Equipment_Title}"
                      ContentTemplate="{DataTemplate views:EquipmentListPage}"
                      Route="equipment" />
        <ShellContent Title="{loc:Translate Settings_Title}"
                      ContentTemplate="{DataTemplate views:MainPage}"
                      Route="settings" />
    </TabBar>

</Shell>
