<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS and Android only. Windows and Mac Catalyst are a csproj line away
         if they are ever wanted; carrying them now would mean maintaining
         layouts for surfaces with no users.

         The iOS target framework is added only on hosts that can build it. NuGet
         restore evaluates every TargetFramework listed, so an unconditional
         net10.0-ios entry fails restore on Linux, including CI and any Linux dev
         machine, even when the build only asks for Android. This condition is
         the same one the .NET 10 MAUI template now uses. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Humo.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>Humo</ApplicationTitle>
    <ApplicationId>com.humoapp.humo</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#2B1B12" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2B1B12" BaseSize="128,128" />
    <!-- .gitkeep holds the empty folder in git; Resizetizer would otherwise try
         to treat it as an image and reject the filename. -->
    <MauiImage Include="Resources\Images\*" Exclude="Resources\Images\.gitkeep" />
  </ItemGroup>

  <!-- No MauiXaml glob here: the MAUI SDK already includes **\*.xaml by default,
       and adding our own registers every page twice (CS1508). -->

  <!-- No custom fonts are registered yet: system fonts are legible, and every
       added font is another asset to license and ship. Add them when the design
       calls for them, not before. -->

  <ItemGroup>
    <!-- MAUI is referenced explicitly. `UseMaui=true` brings in the SDK and its
         targets but does NOT add this package reference; without it the project
         restores cleanly and then fails to compile with "type or namespace
         Microsoft.Maui not found". Versions come from Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Humo.Core\Humo.Core.csproj" />
    <ProjectReference Include="..\Humo.Shared\Humo.Shared.csproj" />
  </ItemGroup>

  <!-- Humo.App holds Views, platform service implementations and DI wiring, and
       nothing else. ViewModels and services live in Humo.Core so they can be
       unit-tested without the MAUI workload or a device. -->

</Project>
