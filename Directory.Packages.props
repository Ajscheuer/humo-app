<Project>

  <!-- Central package management: versions live here, csproj files reference
       packages without a version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below pin a transitive dependency without adding a
         direct PackageReference for it. Used for the SQLite native package. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="MAUI">
    <!-- Versions for the package references the MAUI SDK adds implicitly.
         Required by central package management; see Directory.Build.props. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <!-- Charting, used only by Humo.App and only behind the CookChartData
         abstraction in Humo.Core. Verified before adopting, per architecture.md
         open question 4: 2.0.5 is stable rather than beta, the licence is MIT
         with no commercial tier (unlike FluentAssertions 8, which this project
         already had to avoid), and it ships assemblies for net10.0-android and
         net10.0-ios, which are both of our targets. -->
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup Label="App and shared">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="sqlite-net-pcl" Version="1.9.172" />
    <!-- Two problems with what sqlite-net-pcl pulls in, both pinned forward here.
         Remove these once sqlite-net-pcl ships newer dependencies itself.
         1. SQLitePCLRaw 2.1.2's native .so is not 16 KB page aligned, which
            Android 16 will reject (build warning XA0141).
         2. lib.e_sqlite3 through 2.1.11 carries a high-severity SQLite advisory
            (GHSA-2m69-gcr7-jv3q), which .NET 10's NuGet audit reports as an
            error under TreatWarningsAsErrors. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!-- The DI container itself. Humo.Core depends on the abstractions only; the
         tests build a real container to prove the app's registrations resolve. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Deliberately not here yet, added by the slice that first needs them:
       the notification plugin (slice 8, MAUI-side), RevenueCat (slice 6),
       EF Core + Azure SQL provider (slice 5), Azure.Storage.Blobs (photos).

       FluentAssertions is deliberately absent despite being named in the plan:
       version 8 requires a paid licence for commercial use. Tests use xUnit's
       own assertions instead. -->

</Project>
