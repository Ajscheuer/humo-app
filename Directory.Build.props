<Project>

  <!-- Settings shared by every project in the solution. Per-project csproj files
       should stay small; anything true for all of Humo belongs here. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- InvariantGlobalization must stay false: Humo formats dates and numbers per
       culture (English and Spanish), which requires real ICU data. -->

  <!-- The MAUI workload version, pinned here so central package management can
       resolve MAUI's implicit package references. Without a PackageVersion for
       them (see Directory.Packages.props), CPM strips the version off those
       implicit references and they are dropped SILENTLY. The app then fails to
       compile with "type or namespace Microsoft.Maui not found", which reads
       like a code error rather than the restore error it is. Keep this in step
       with the installed workload. -->
  <PropertyGroup>
    <MauiVersion>9.0.120</MauiVersion>
  </PropertyGroup>

</Project>
